# Contoh env dev — salin ke .env bila perlu override (SAD §1.2)
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_dev_password
POSTGRES_DB=your_db_name
DATABASE_URL=postgresql://your_db_user:your_secure_dev_password@localhost:5432/your_db_name?schema=public
JWT_ACCESS_SECRET=your_super_secret_access_key_change_me_32_chars_min
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me_32_chars_min
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://api:4000/api/v1
TZ=Asia/Jakarta
