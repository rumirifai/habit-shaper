# Contoh env dev — salin ke .env bila perlu override (SAD §1.2)
POSTGRES_USER=habit
POSTGRES_PASSWORD=habit_dev_password
POSTGRES_DB=habitshaper
DATABASE_URL=postgresql://habit:habit_dev_password@localhost:5432/habitshaper?schema=public
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://api:4000/api/v1
TZ=Asia/Jakarta
