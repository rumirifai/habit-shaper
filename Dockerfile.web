# Dockerfile.web — Next.js App Router (SAD §1.2)
# Build context: repo root. Service "web" di docker-compose.yml.
FROM node:20-alpine AS base
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json tsconfig.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/web/tsconfig.json ./apps/web/tsconfig.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/shared/tsconfig.json ./packages/shared/tsconfig.json
RUN npm ci

FROM deps AS builder
COPY apps/web ./apps/web
COPY packages/shared/src ./packages/shared/src
COPY tsconfig.json ./
WORKDIR /app
RUN npm run build --workspace @habit-shaper/web

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder /app/apps/web/public ./apps/web/public
# Full node_modules agar `command` dev (next dev/tsc) bisa jalan di Compose dev.
# Mode production (`node apps/web/server.js`) tidak memakai ini.
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
